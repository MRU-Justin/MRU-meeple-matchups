# Editor settings that travel with the project, so a file looks the same
# whether it's opened on Windows or on a Mac.
#
# VS Code needs the EditorConfig extension to honour this; most other editors
# support it natively.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# The JavaScript side of the course uses 2 spaces, matching .prettierrc.
[*.{js,mjs,cjs,json,css,html,yml,yaml}]
indent_size = 2

# Trailing whitespace is meaningful in Markdown (it forces a line break).
[*.md]
trim_trailing_whitespace = false
